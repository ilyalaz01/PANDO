# Public Supabase connection values. Never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only fixed Mastery projection worker. Never expose either value to NEXT_PUBLIC_*, Git,
# browser bundles, logs, or client forms. Generate the dispatch secret with at least 32 random
# characters; the service-role value comes from the linked Supabase project's API settings.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
PANDO_INTERNAL_DISPATCH_SECRET=replace_with_at_least_32_random_characters
