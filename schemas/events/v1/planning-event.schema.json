{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/events/v1/planning-event.schema.json",
  "title": "PANDO Planning Input Event V1",
  "oneOf": [
    { "$ref": "#/$defs/growthPlanInitialized" },
    { "$ref": "#/$defs/trackActivityAdmitted" },
    { "$ref": "#/$defs/planLifecycleChanged" },
    { "$ref": "#/$defs/planCapacityChanged" },
    { "$ref": "#/$defs/trackLifecycleChanged" },
    { "$ref": "#/$defs/trackPriorityMinimumChanged" }
  ],
  "$defs": {
    "growthPlanInitialized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_kind",
            "growth_plan_id",
            "growth_plan_version",
            "learning_track_id",
            "learning_track_version",
            "readiness_goal_id",
            "profile_version_id"
          ],
          "properties": {
            "change_kind": { "const": "INITIALIZED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "growth_plan_version": { "$ref": "#/$defs/safePositiveInteger" },
            "learning_track_id": { "$ref": "#/$defs/uuid" },
            "learning_track_version": { "$ref": "#/$defs/safePositiveInteger" },
            "readiness_goal_id": { "$ref": "#/$defs/uuid" },
            "profile_version_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "trackActivityAdmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_kind",
            "growth_plan_id",
            "learning_track_id",
            "learning_track_version",
            "custom_activity_id",
            "candidate_key"
          ],
          "properties": {
            "change_kind": { "const": "TRACK_ACTIVITY_ADMITTED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "learning_track_id": { "$ref": "#/$defs/uuid" },
            "learning_track_version": { "$ref": "#/$defs/positiveBigint" },
            "custom_activity_id": { "$ref": "#/$defs/uuid" },
            "candidate_key": {
              "type": "string",
              "pattern": "^candidate:[a-z0-9][a-z0-9-]{1,100}$"
            }
          }
        }
      }
    },
    "planLifecycleChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_kind",
            "growth_plan_id",
            "growth_plan_version",
            "lifecycle"
          ],
          "properties": {
            "change_kind": { "const": "PLAN_LIFECYCLE_CHANGED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "growth_plan_version": { "$ref": "#/$defs/positiveBigint" },
            "lifecycle": { "enum": ["ACTIVE", "PAUSED"] }
          }
        }
      }
    },
    "planCapacityChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_kind",
            "growth_plan_id",
            "growth_plan_version",
            "weekly_capacity_minutes"
          ],
          "properties": {
            "change_kind": { "const": "PLAN_CAPACITY_CHANGED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "growth_plan_version": { "$ref": "#/$defs/positiveBigint" },
            "weekly_capacity_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 }
          }
        }
      }
    },
    "trackLifecycleChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_kind", "growth_plan_id", "learning_track_id", "learning_track_version", "lifecycle"],
          "properties": {
            "change_kind": { "const": "TRACK_LIFECYCLE_CHANGED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "learning_track_id": { "$ref": "#/$defs/uuid" },
            "learning_track_version": { "$ref": "#/$defs/positiveBigint" },
            "lifecycle": { "enum": ["ACTIVE", "PAUSED"] }
          }
        }
      }
    },
    "trackPriorityMinimumChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
      "properties": {
        "event_name": { "const": "planning.input_changed" },
        "event_schema_version": { "const": 1 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_kind",
            "growth_plan_id",
            "learning_track_id",
            "learning_track_version",
            "priority",
            "protected_minimum_minutes"
          ],
          "properties": {
            "change_kind": { "const": "TRACK_PRIORITY_MINIMUM_CHANGED" },
            "growth_plan_id": { "$ref": "#/$defs/uuid" },
            "learning_track_id": { "$ref": "#/$defs/uuid" },
            "learning_track_version": { "$ref": "#/$defs/positiveBigint" },
            "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
            "protected_minimum_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10080
            }
          }
        }
      }
    },
    "uuid": { "type": "string", "format": "uuid" },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    }
  }
}
