{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/events/v1/review-event.schema.json",
  "title": "PANDO Review Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_name", "event_schema_version", "workspace_id", "payload"],
  "properties": {
    "event_name": { "const": "review.item_changed" },
    "event_schema_version": { "const": 1 },
    "workspace_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_ref",
        "subject_type",
        "competency_ref",
        "dimension",
        "subject_version",
        "effective_due_at",
        "active_reason_types",
        "projection_status"
      ],
      "properties": {
        "subject_id": { "type": "string", "format": "uuid" },
        "subject_ref": {
          "type": "string",
          "pattern": "^competency:[a-z0-9][a-z0-9-]{1,100}/(?:knowledge|recall|application|interview_execution)$"
        },
        "subject_type": { "const": "COMPETENCY_DIMENSION" },
        "competency_ref": {
          "type": "string",
          "pattern": "^competency:[a-z0-9][a-z0-9-]{1,100}$"
        },
        "dimension": {
          "enum": ["KNOWLEDGE", "RECALL", "APPLICATION", "INTERVIEW_EXECUTION"]
        },
        "subject_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "effective_due_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
            },
            { "type": "null" }
          ]
        },
        "active_reason_types": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RETENTION_RISK",
              "PERSONAL_REMINDER",
              "GOAL_DEADLINE",
              "VERIFICATION_NEEDED"
            ]
          }
        },
        "projection_status": {
          "enum": ["CURRENT", "INACTIVE", "SUPPRESSED"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "projection_status": { "const": "CURRENT" } },
            "required": ["projection_status"]
          },
          "then": {
            "properties": {
              "effective_due_at": { "type": "string" },
              "active_reason_types": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "projection_status": { "enum": ["INACTIVE", "SUPPRESSED"] }
            },
            "required": ["projection_status"]
          },
          "then": {
            "properties": {
              "effective_due_at": { "type": "null" },
              "active_reason_types": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "dimension": { "const": "KNOWLEDGE" } },
            "required": ["dimension"]
          },
          "then": {
            "properties": { "subject_ref": { "type": "string", "pattern": "/knowledge$" } }
          }
        },
        {
          "if": {
            "properties": { "dimension": { "const": "RECALL" } },
            "required": ["dimension"]
          },
          "then": {
            "properties": { "subject_ref": { "type": "string", "pattern": "/recall$" } }
          }
        },
        {
          "if": {
            "properties": { "dimension": { "const": "APPLICATION" } },
            "required": ["dimension"]
          },
          "then": {
            "properties": { "subject_ref": { "type": "string", "pattern": "/application$" } }
          }
        },
        {
          "if": {
            "properties": { "dimension": { "const": "INTERVIEW_EXECUTION" } },
            "required": ["dimension"]
          },
          "then": {
            "properties": {
              "subject_ref": { "type": "string", "pattern": "/interview_execution$" }
            }
          }
        }
      ]
    }
  }
}
