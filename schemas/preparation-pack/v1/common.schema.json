{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pando.invalid/preparation-pack/v1/common.schema.json",
  "title": "PANDO Preparation Pack v1 common definitions",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 64
    },
    "packId": {
      "type": "string",
      "pattern": "^pack:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 69
    },
    "contextId": {
      "type": "string",
      "pattern": "^context:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 72
    },
    "profileId": {
      "type": "string",
      "pattern": "^target-profile:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 79
    },
    "planId": {
      "type": "string",
      "pattern": "^preparation-plan:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 81
    },
    "canonicalCompetencyId": {
      "type": "string",
      "pattern": "^competency:[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$",
      "maxLength": 91
    },
    "proposedCompetencyId": {
      "type": "string",
      "pattern": "^personal-competency:[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$",
      "maxLength": 100
    },
    "sourceId": {
      "type": "string",
      "pattern": "^source:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 71
    },
    "requirementId": {
      "type": "string",
      "pattern": "^requirement:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 76
    },
    "requirementGroupId": {
      "type": "string",
      "pattern": "^requirement-group:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 82
    },
    "activityId": {
      "type": "string",
      "pattern": "^personal-activity:[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$",
      "maxLength": 97
    },
    "phaseId": {
      "type": "string",
      "pattern": "^phase:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 70
    },
    "milestoneId": {
      "type": "string",
      "pattern": "^milestone:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "maxLength": 74
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "maxLength": 40
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "objectiveLevel": {
      "type": "string",
      "enum": ["NOT_STARTED", "COMPLETED", "VERIFIED", "MASTERED"]
    },
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "contextFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "canonicalization"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalization": { "const": "pando-preparation-context-v1" }
      }
    },
    "canonicalCompetencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "competency_id", "catalog_version"],
      "properties": {
        "kind": { "const": "canonical" },
        "competency_id": { "$ref": "#/$defs/canonicalCompetencyId" },
        "catalog_version": { "$ref": "#/$defs/semver" }
      }
    },
    "proposedCompetencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proposed_competency_id"],
      "properties": {
        "kind": { "const": "proposed" },
        "proposed_competency_id": { "$ref": "#/$defs/proposedCompetencyId" }
      }
    },
    "competencyRef": {
      "oneOf": [
        { "$ref": "#/$defs/canonicalCompetencyRef" },
        { "$ref": "#/$defs/proposedCompetencyRef" }
      ]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceId" }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "confidence", "source_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "effortRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_minutes", "maximum_minutes"],
      "properties": {
        "minimum_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "maximum_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    }
  }
}
