{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pando.invalid/preparation-pack/v1/preparation-context-1.0.0.schema.json",
  "title": "PANDO Preparation Context",
  "description": "Compact, non-authoritative input exported for external Preparation Pack authoring. The context fingerprint covers this document with context_fingerprint omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "exported_at",
    "context_fingerprint",
    "goal",
    "availability",
    "catalog",
    "competency_summaries",
    "growth_plan"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "context_id": { "$ref": "common.schema.json#/$defs/contextId" },
    "exported_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "context_fingerprint": { "$ref": "common.schema.json#/$defs/contextFingerprint" },
    "goal": { "$ref": "#/$defs/goal" },
    "availability": { "$ref": "#/$defs/availability" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "competency_summaries": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/competencySummary" }
    },
    "growth_plan": { "$ref": "#/$defs/growthPlan" }
  },
  "$defs": {
    "goal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title"],
          "properties": {
            "kind": { "const": "growth_plan" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "deadline"],
          "properties": {
            "kind": { "const": "interview_campaign" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "company": { "type": "string", "minLength": 1, "maxLength": 160 },
            "role": { "type": "string", "minLength": 1, "maxLength": 160 },
            "deadline": { "$ref": "common.schema.json#/$defs/date" },
            "vacancy_text": { "type": "string", "minLength": 1, "maxLength": 20000 }
          }
        }
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "weekly_minutes"],
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+$",
          "maxLength": 64
        },
        "weekly_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "unavailable_dates": {
          "type": "array",
          "maxItems": 366,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/date" }
        },
        "constraints": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_version", "supported_competencies"],
      "properties": {
        "catalog_version": { "$ref": "common.schema.json#/$defs/semver" },
        "supported_competencies": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["competency_id", "title"],
            "properties": {
              "competency_id": { "$ref": "common.schema.json#/$defs/canonicalCompetencyId" },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        }
      }
    },
    "unknownDimensionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state", "confidence"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["Knowledge", "Recall", "Application", "InterviewExecution"]
        },
        "state": { "const": "Unknown" },
        "confidence": { "const": "unknown" }
      }
    },
    "knownDimensionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state", "condition", "confidence", "last_meaningful_evidence_at"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["Knowledge", "Recall", "Application", "InterviewExecution"]
        },
        "state": { "$ref": "common.schema.json#/$defs/objectiveLevel" },
        "condition": { "type": "string", "enum": ["Weak", "Stale", "Strong"] },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "last_meaningful_evidence_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "dimensionSummary": {
      "oneOf": [
        { "$ref": "#/$defs/unknownDimensionSummary" },
        { "$ref": "#/$defs/knownDimensionSummary" }
      ]
    },
    "competencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competency_ref", "dimensions"],
      "properties": {
        "competency_ref": { "$ref": "common.schema.json#/$defs/canonicalCompetencyRef" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/dimensionSummary" }
        },
        "self_confidence": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "growthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "tracks"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["track_id", "title", "priority", "protected_weekly_minutes"],
            "properties": {
              "track_id": {
                "type": "string",
                "pattern": "^track:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
                "maxLength": 70
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
              "protected_weekly_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 }
            }
          }
        }
      }
    }
  }
}
