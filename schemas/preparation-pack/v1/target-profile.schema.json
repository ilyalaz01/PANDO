{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pando.invalid/preparation-pack/v1/target-profile-1.0.0.schema.json",
  "title": "PANDO Preparation Pack target profile proposal",
  "description": "An untrusted workspace-scoped draft. Import never publishes canonical content or readiness truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "scope",
    "lifecycle",
    "title",
    "role",
    "metadata_confidence",
    "metadata_source_refs",
    "sources",
    "requirements",
    "requirement_groups",
    "interview_stages",
    "proposed_competencies",
    "prerequisite_proposals",
    "unknowns",
    "assumptions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "$ref": "common.schema.json#/$defs/profileId" },
    "profile_version": { "$ref": "common.schema.json#/$defs/semver" },
    "scope": { "const": "workspace" },
    "lifecycle": { "const": "draft" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "role": { "type": "string", "minLength": 1, "maxLength": 160 },
    "company": { "type": "string", "minLength": 1, "maxLength": 160 },
    "metadata_confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "metadata_source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" },
    "vacancy_reference": {
      "type": "string",
      "pattern": "^(https://|attachment:|user-provided:)[^\\u0000-\\u001f\\u007f]{1,2000}$",
      "maxLength": 2048
    },
    "deadline": { "$ref": "common.schema.json#/$defs/date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/source" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "requirement_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/requirementGroup" }
    },
    "interview_stages": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/interviewStage" }
    },
    "proposed_competencies": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/proposedCompetency" }
    },
    "prerequisite_proposals": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/prerequisiteProposal" }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.schema.json#/$defs/claim" }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.schema.json#/$defs/claim" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "label", "assertion_status"],
      "properties": {
        "source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
        "kind": {
          "type": "string",
          "enum": ["vacancy", "recruiter", "user_provided", "research", "unconfirmed"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "locator": {
          "type": "string",
          "pattern": "^(https://|attachment:|user-provided:)[^\\u0000-\\u001f\\u007f]{1,2000}$",
          "maxLength": 2048
        },
        "assertion_status": {
          "type": "string",
          "enum": ["sourced", "user-stated", "unconfirmed"]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "subject_ref",
        "category",
        "weight",
        "minimum_level",
        "criticality",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "requirement_id": { "$ref": "common.schema.json#/$defs/requirementId" },
        "subject_ref": { "$ref": "common.schema.json#/$defs/competencyRef" },
        "category": {
          "type": "string",
          "enum": ["mandatory", "preferred", "differentiating"]
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_level": { "$ref": "common.schema.json#/$defs/objectiveLevel" },
        "criticality": {
          "type": "string",
          "enum": ["blocking", "important", "supporting"]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" }
      }
    },
    "allRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "ALL" } }
    },
    "anyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "ANY" } }
    },
    "kOfNRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "k"],
      "properties": {
        "kind": { "const": "K_OF_N" },
        "k": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "weightedThresholdRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "threshold"],
      "properties": {
        "kind": { "const": "WEIGHTED_THRESHOLD" },
        "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "mandatoryFloorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "floor"],
      "properties": {
        "kind": { "const": "MANDATORY_FLOOR" },
        "floor": { "$ref": "common.schema.json#/$defs/objectiveLevel" }
      }
    },
    "requirementRule": {
      "oneOf": [
        { "$ref": "#/$defs/allRule" },
        { "$ref": "#/$defs/anyRule" },
        { "$ref": "#/$defs/kOfNRule" },
        { "$ref": "#/$defs/weightedThresholdRule" },
        { "$ref": "#/$defs/mandatoryFloorRule" }
      ]
    },
    "requirementGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_group_id", "title", "member_requirement_ids", "rule", "confidence", "source_refs"],
      "properties": {
        "requirement_group_id": { "$ref": "common.schema.json#/$defs/requirementGroupId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "member_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/requirementId" }
        },
        "rule": { "$ref": "#/$defs/requirementRule" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" }
      }
    },
    "interviewStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "title", "order", "confidence", "source_refs"],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^stage:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
          "maxLength": 70
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "order": { "type": "integer", "minimum": 1, "maximum": 50 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" }
      }
    },
    "proposedCompetency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_competency_id",
        "scope",
        "lifecycle",
        "title",
        "description",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "proposed_competency_id": { "$ref": "common.schema.json#/$defs/proposedCompetencyId" },
        "scope": { "const": "workspace" },
        "lifecycle": { "const": "draft" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" }
      }
    },
    "prerequisiteProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relationship", "confidence", "source_refs"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/competencyRef" },
        "to": { "$ref": "common.schema.json#/$defs/competencyRef" },
        "relationship": { "const": "PREREQUISITE_OF" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "source_refs": { "$ref": "common.schema.json#/$defs/sourceRefs" }
      }
    }
  }
}
