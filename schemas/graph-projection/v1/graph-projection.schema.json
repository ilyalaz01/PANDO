        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "sortKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[0-9]{2,6}:[a-z0-9][a-z0-9-]*$"
        },
        "childItemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "accessibilityLabel": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "rootItemIds",
