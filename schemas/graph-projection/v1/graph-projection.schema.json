    "mandatoryFloorRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleType",
        "title",
        "criticality",
        "explanation",
        "accessibilityLabel",
        "member"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/stableId"
        },
        "ruleType": {
          "const": "MANDATORY_FLOOR"
        },
        "title": {
          "$ref": "#/$defs/safeText"
        },
        "criticality": {
          "const": "MANDATORY"
