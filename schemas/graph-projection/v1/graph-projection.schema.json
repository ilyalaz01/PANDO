{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pando.dev/graph-projection/v1/graph-projection.schema.json",
  "title": "GraphProjectionV1",
  "description": "Server-owned semantic and deterministic layout projection shared by Map and Outline. Client-owned viewport, selection, filters, focus, semantic zoom, and temporary interaction state are intentionally not part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "projectionId",
    "workspaceScope",
    "selectedVersions",
    "projectionState",
    "layout",
    "nodes",
    "edges",
    "requirements",
    "readiness",
    "visibilityHints",
    "outline"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "GraphProjectionV1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "projectionId": {
      "$ref": "#/$defs/stableId"
    },
    "workspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "overlayRevision",
        "acceptedPersonalContentOnly"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/stableId"
        },
        "overlayRevision": {
          "$ref": "#/$defs/stableId"
        },
        "acceptedPersonalContentOnly": {
          "const": true
        }
      }
    },
    "selectedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogVersionId",
        "roadmapTemplateVersionId",
        "targetProfileVersionId",
        "masteryPolicyVersion",
        "readinessPolicyVersion"
      ],
      "properties": {
        "catalogVersionId": {
          "$ref": "#/$defs/stableId"
        },
        "roadmapTemplateVersionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetProfileVersionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "masteryPolicyVersion": {
          "$ref": "#/$defs/versionString"
        },
        "readinessPolicyVersion": {
          "$ref": "#/$defs/versionString"
        }
      }
    },
    "projectionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticRevision",
        "inputWatermark",
        "generatedAt",
        "calculationState",
        "staleReason",
        "explanation"
      ],
      "properties": {
        "semanticRevision": {
          "$ref": "#/$defs/stableId"
        },
        "inputWatermark": {
          "$ref": "#/$defs/stableId"
        },
        "generatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "calculationState": {
          "enum": [
            "CURRENT",
            "STALE",
            "REBUILDING",
            "ERROR"
          ]
        },
        "staleReason": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layoutVersion",
        "algorithmVersion",
        "structuralFingerprint",
        "coordinateSystem",
        "fixedNodeSize",
        "spacing",
        "positions"
      ],
      "properties": {
        "layoutVersion": {
          "$ref": "#/$defs/versionString"
        },
        "algorithmVersion": {
          "$ref": "#/$defs/versionString"
        },
        "structuralFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "coordinateSystem": {
          "const": "TOP_LEFT"
        },
        "fixedNodeSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank",
            "node"
          ],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "node": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            }
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutPosition"
          },
          "maxItems": 500
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectionNode"
      },
      "maxItems": 500
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectionEdge"
      },
      "maxItems": 5000
    },
    "requirements": {
      "$ref": "#/$defs/requirementSet"
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "visibilityHints": {
      "$ref": "#/$defs/visibilityHints"
    },
    "outline": {
      "$ref": "#/$defs/outline"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?::[a-z0-9][a-z0-9-]*)+$"
    },
    "versionString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^<>]+$"
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceVersionId"
          ],
          "properties": {
            "kind": {
              "const": "CANONICAL"
            },
            "sourceVersionId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workspaceId",
            "overlayRevision",
            "acceptance"
          ],
          "properties": {
            "kind": {
              "const": "WORKSPACE_OVERLAY"
            },
            "workspaceId": {
              "$ref": "#/$defs/stableId"
            },
            "overlayRevision": {
              "$ref": "#/$defs/stableId"
            },
            "acceptance": {
              "const": "ACCEPTED"
            }
          }
        }
      ]
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "entityId",
        "entityVersionId"
      ],
      "properties": {
        "entityType": {
          "enum": [
            "DOMAIN",
            "GROUP",
            "COMPETENCY",
            "ACTIVITY"
          ]
        },
        "entityId": {
          "$ref": "#/$defs/stableId"
        },
        "entityVersionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unknownEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "lastMeaningfulEvidenceAt"
      ],
      "properties": {
        "availability": {
          "const": "UNKNOWN"
        },
        "lastMeaningfulEvidenceAt": {
          "type": "null"
        }
      }
    },
    "knownEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "condition",
        "confidence",
        "lastMeaningfulEvidenceAt"
      ],
      "properties": {
        "availability": {
          "const": "KNOWN"
        },
        "condition": {
          "enum": [
            "WEAK",
            "STALE",
            "STRONG"
          ]
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "lastMeaningfulEvidenceAt": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "achievementLevel",
        "estimate",
        "policyVersion",
        "summaryText"
      ],
      "properties": {
        "achievementLevel": {
          "oneOf": [
            {
              "enum": [
                "NOT_STARTED",
                "COMPLETED",
                "VERIFIED",
                "MASTERED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "estimate": {
          "oneOf": [
            {
              "$ref": "#/$defs/unknownEstimate"
            },
            {
              "$ref": "#/$defs/knownEstimate"
            }
          ]
        },
        "policyVersion": {
          "$ref": "#/$defs/versionString"
        },
        "summaryText": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "activityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycleStatus",
        "evidenceExpectation",
        "summaryText"
      ],
      "properties": {
        "lifecycleStatus": {
          "enum": [
            "AVAILABLE",
            "IN_PROGRESS",
            "COMPLETED",
            "UNAVAILABLE"
          ]
        },
        "evidenceExpectation": {
          "enum": [
            "NONE",
            "POSSIBLE",
            "EXPECTED"
          ]
        },
        "summaryText": {
          "$ref": "#/$defs/safeText"
        }
      }
    },
    "attainmentInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "requirementState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "NOT_REQUIRED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ruleIds",
            "attainment",
            "floorStatus"
          ],
          "properties": {
            "kind": {
              "const": "REQUIRED_UNKNOWN"
            },
            "ruleIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/stableId"
              }
            },
            "attainment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lower",
                "upper"
              ],
              "properties": {
                "lower": {
                  "const": 0
                },
                "upper": {
                  "const": 1
                }
              }
            },
            "floorStatus": {
              "enum": [
                "NOT_APPLICABLE",
                "UNKNOWN"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ruleIds",
            "attainment",
            "floorStatus"
          ],
          "properties": {
            "kind": {
              "const": "REQUIRED_KNOWN"
            },
            "ruleIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/stableId"
              }
            },
            "attainment": {
              "$ref": "#/$defs/attainmentInterval"
            },
            "floorStatus": {
              "enum": [
                "NOT_APPLICABLE",
                "BELOW",
                "MET"
              ]
            }
          }
        }
      ]
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "statusText",
        "keyboardOrder",
        "outlineItemId"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/safeText"
        },
        "description": {
          "$ref": "#/$defs/safeText"
        },
        "statusText": {
          "$ref": "#/$defs/safeText"
        },
        "keyboardOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "outlineItemId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "nodeVisibilityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultVisible",
        "availableAtDetailLevels",
        "reasonCodes"
      ],
      "properties": {
        "defaultVisible": {
          "type": "boolean"
        },
        "availableAtDetailLevels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DOMAIN",
              "GROUP",
              "COMPETENCY",
              "SELECTED_ACTIVITY"
            ]
          }
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CRITICAL_PATH",
              "MANDATORY_BLOCKER",
              "PERSONAL_OVERLAY",
              "REQUIRED_BY_TARGET",
              "SELECTED_CONTEXT",
              "STRUCTURAL_CONTEXT"
            ]
          }
        }
      }
    },
    "projectionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "nodeType",
        "entityRef",
        "origin",
        "domainNodeId",
        "title",
        "shortLabel",
        "state",
        "requirementState",
        "explanations",
        "visibilityHint",
        "accessibility",
        "inspectorRef"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableId"
        },
        "nodeType": {
          "enum": [
            "DOMAIN",
            "GROUP",
            "COMPETENCY",
            "ACTIVITY"
          ]
        },
        "entityRef": {
          "$ref": "#/$defs/entityRef"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "domainNodeId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/safeText"
        },
        "shortLabel": {
          "$ref": "#/$defs/safeText"
        },
        "state": {
          "oneOf": [
            {
              "$ref": "#/$defs/semanticState"
            },
            {
              "$ref": "#/$defs/activityState"
            }
          ]
        },
        "requirementState": {
          "$ref": "#/$defs/requirementState"
        },
        "explanations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/structuredExplanation"
          }
        },
        "visibilityHint": {
          "$ref": "#/$defs/nodeVisibilityHint"
        },
        "accessibility": {
          "$ref": "#/$defs/accessibility"
        },
        "inspectorRef": {
          "$ref": "#/$defs/stableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "DOMAIN"
              }
            }
          },
          "then": {
            "properties": {
              "entityRef": {
                "properties": {
                  "entityType": {
                    "const": "DOMAIN"
                  }
                }
              },
              "domainNodeId": {
                "type": "null"
              },
              "state": {
                "$ref": "#/$defs/semanticState",
                "properties": {
                  "achievementLevel": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "GROUP"
              }
            }
          },
          "then": {
            "properties": {
              "entityRef": {
                "properties": {
                  "entityType": {
                    "const": "GROUP"
                  }
                }
              },
              "state": {
                "$ref": "#/$defs/semanticState",
                "properties": {
                  "achievementLevel": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "COMPETENCY"
              }
            }
          },
          "then": {
            "properties": {
              "entityRef": {
                "properties": {
                  "entityType": {
                    "const": "COMPETENCY"
                  }
                }
              },
              "state": {
                "$ref": "#/$defs/semanticState",
                "properties": {
                  "achievementLevel": {
                    "enum": [
                      "NOT_STARTED",
                      "COMPLETED",
                      "VERIFIED",
                      "MASTERED"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "ACTIVITY"
              }
            }
          },
          "then": {
            "properties": {
              "entityRef": {
                "properties": {
                  "entityType": {
                    "const": "ACTIVITY"
                  }
                }
              },
              "state": {
                "$ref": "#/$defs/activityState"
              }
            }
          }
        }
      ]
    },
    "edgeVisibilityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultVisible",
        "reasonCode"
      ],
      "properties": {
        "defaultVisible": {
          "type": "boolean"
        },
        "reasonCode": {
          "enum": [
            "ACTIVE_PREREQUISITE",
            "NAVIGATION_ONLY",
            "PERSONAL_CONTEXT",
            "SEMANTIC_CONTEXT"
          ]
        }
      }
    },
    "projectionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "edgeType",
        "sourceNodeId",
        "targetNodeId",
        "origin",
        "blocking",
        "rationale",
        "accessibilityLabel",
        "visibilityHint"
      ],
      "properties": {
        "edgeId": {
          "$ref": "#/$defs/stableId"
        },
        "edgeType": {
          "enum": [
            "PREREQUISITE_OF",
            "RELATED_TO",
            "PART_OF",
            "ACTIVITY_EVIDENCES",
            "USER_ADDED"
          ]
        },
        "sourceNodeId": {
          "$ref": "#/$defs/stableId"
        },
        "targetNodeId": {
          "$ref": "#/$defs/stableId"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "blocking": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "#/$defs/safeText"
        },
        "accessibilityLabel": {
          "$ref": "#/$defs/safeText"
        },
        "visibilityHint": {
          "$ref": "#/$defs/edgeVisibilityHint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "edgeType": {
                "not": {
                  "const": "PREREQUISITE_OF"
                }
              }
            }
          },
          "then": {
            "properties": {
              "blocking": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "edgeType": {
                "const": "USER_ADDED"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "properties": {
                  "kind": {
                    "const": "WORKSPACE_OVERLAY"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nodeRequirementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberType",
        "nodeId",
        "dimension",
        "requiredLevel"
      ],
      "properties": {
        "memberType": {
          "const": "NODE"
        },
        "nodeId": {
          "$ref": "#/$defs/stableId"
        },
        "dimension": {
          "enum": [
            "KNOWLEDGE",
            "RECALL",
            "APPLICATION",
            "INTERVIEW_EXECUTION"
          ]
        },
        "requiredLevel": {
          "enum": [
            "COMPLETED",
            "VERIFIED",
            "MASTERED"
          ]
        }
      }
    },
    "ruleRequirementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberType",
        "ruleId"
      ],
      "properties": {
        "memberType": {
          "const": "RULE"
        },
        "ruleId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "requirementMember": {
      "oneOf": [
        {
          "$ref": "#/$defs/nodeRequirementMember"
        },
        {
          "$ref": "#/$defs/ruleRequirementMember"
        }
      ]
    },
    "weightedRequirementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "weight"
      ],
      "properties": {
        "member": {
          "$ref": "#/$defs/requirementMember"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "allRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleType",
        "title",
        "criticality",
        "explanation",
        "accessibilityLabel",
        "members"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/stableId"
        },
        "ruleType": {
          "const": "ALL"
        },
        "title": {
          "$ref": "#/$defs/safeText"
        },
        "criticality": {
          "enum": [
            "MANDATORY",
            "PREFERRED",
            "DIFFERENTIATING"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/safeText"
        },
        "accessibilityLabel": {
          "$ref": "#/$defs/safeText"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementMember"
          }
        }
      }
    },
    "anyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleType",
        "title",
        "criticality",
        "explanation",
        "accessibilityLabel",
        "members"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/stableId"
        },
        "ruleType": {
          "const": "ANY"
        },
        "title": {
