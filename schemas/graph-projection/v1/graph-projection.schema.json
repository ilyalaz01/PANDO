        "accessibilityLabel": {
          "$ref": "#/$defs/safeText"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementMember"
          }
        }
      }
