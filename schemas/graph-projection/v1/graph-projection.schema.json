      ],
      "properties": {
        "projectionId": {
          "$ref": "#/$defs/stableId"
        },
        "rootItemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outlineItem"
          },
          "maxItems": 500
        }
      }
    },
    "layoutPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "canonical",
        "effective",
        "source",
        "overrideRevision"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableId"
        },
        "canonical": {
          "$ref": "#/$defs/point"
        },
        "effective": {
          "$ref": "#/$defs/point"
        },
        "source": {
          "enum": [
            "CANONICAL_LAYOUT",
            "WORKSPACE_OVERRIDE"
          ]
        },
        "overrideRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "overrideWorkspaceId": {
          "$ref": "#/$defs/stableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "WORKSPACE_OVERRIDE"
              }
            }
          },
          "then": {
            "required": [
              "overrideWorkspaceId"
            ],
            "properties": {
              "overrideRevision": {
                "$ref": "#/$defs/stableId"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "overrideWorkspaceId"
              ]
            },
            "properties": {
              "overrideRevision": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    }
