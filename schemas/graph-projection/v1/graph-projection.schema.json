          "$ref": "#/$defs/stableId"
        },
        "estimate": {
          "$ref": "#/$defs/attainmentInterval"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetProfileVersionId",
        "engineVersion",
        "policyVersion",
        "calculatedAt",
        "inputWatermark",
        "status",
        "estimate",
        "coverage",
        "confidence",
        "mandatoryBlockerRuleIds",
        "unknownNodeIds",
        "staleNodeIds",
        "domainBreakdown",
        "explanations",
        "displayLabel"
      ],
      "properties": {
        "targetProfileVersionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "engineVersion": {
          "$ref": "#/$defs/versionString"
        },
        "policyVersion": {
          "$ref": "#/$defs/versionString"
        },
        "calculatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "inputWatermark": {
          "$ref": "#/$defs/stableId"
        },
        "status": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_READY",
            "INSUFFICIENT_EVIDENCE",
            "DEVELOPING",
            "READY"
          ]
        },
        "estimate": {
          "$ref": "#/$defs/attainmentInterval"
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "enum": [
            "NOT_APPLICABLE",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "mandatoryBlockerRuleIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "unknownNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "staleNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "domainBreakdown": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/domainReadiness"
          }
        },
        "explanations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/structuredExplanation"
          }
        },
        "displayLabel": {
          "$ref": "#/$defs/safeText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            }
          },
          "then": {
            "properties": {
              "targetProfileVersionId": {
                "type": "null"
              },
              "estimate": {
                "properties": {
                  "lower": {
                    "const": 0
                  },
                  "upper": {
                    "const": 0
                  }
                }
              },
              "coverage": {
                "const": 0
              },
              "confidence": {
                "const": "NOT_APPLICABLE"
              }
            }
          },
          "else": {
            "properties": {
              "targetProfileVersionId": {
                "$ref": "#/$defs/stableId"
              },
              "confidence": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              }
            }
          }
        }
      ]
    },
