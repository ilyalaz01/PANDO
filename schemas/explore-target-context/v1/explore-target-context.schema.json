{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pando.dev/explore-target-context/v1/explore-target-context.schema.json",
  "title": "ExploreTargetContextV1",
  "description": "Authenticated target requirements and bounded Catalog/Overlay closure used as one input to future Explore materialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "workspaceId",
    "readinessGoal",
    "targetProfile",
    "overlayVersion",
    "requirementRules",
    "scope"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ExploreTargetContextV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "workspaceId": { "type": "string", "format": "uuid" },
    "readinessGoal": { "$ref": "#/$defs/readinessGoal" },
    "targetProfile": { "$ref": "#/$defs/targetProfile" },
    "overlayVersion": { "$ref": "#/$defs/nonNegativeBigint" },
    "requirementRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/requirementRule" }
    },
    "scope": { "$ref": "#/$defs/scope" }
  },
  "$defs": {
    "readinessGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readinessGoalId", "readinessGoalKey", "lifecycle", "aggregateVersion"],
      "properties": {
        "readinessGoalId": { "type": "string", "format": "uuid" },
        "readinessGoalKey": { "$ref": "#/$defs/readinessGoalKey" },
        "lifecycle": { "enum": ["active", "paused", "completed", "archived"] },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "targetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileVersionId",
        "profileVersionKey",
        "catalogVersionKey",
        "roadmapVersionKey",
        "rootRuleKey",
        "readinessThreshold"
      ],
      "properties": {
        "profileVersionId": { "type": "string", "format": "uuid" },
        "profileVersionKey": { "$ref": "#/$defs/profileVersionKey" },
        "catalogVersionKey": { "$ref": "#/$defs/catalogVersionKey" },
        "roadmapVersionKey": {
          "oneOf": [{ "$ref": "#/$defs/roadmapVersionKey" }, { "type": "null" }]
        },
        "rootRuleKey": { "$ref": "#/$defs/ruleKey" },
        "readinessThreshold": { "$ref": "#/$defs/unitIntervalExclusiveZero" }
      }
    },
    "requirementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleKey",
        "ruleType",
        "title",
        "criticality",
        "explanation",
        "accessibilityLabel",
        "requiredCount",
        "threshold",
        "members"
      ],
      "properties": {
        "ruleKey": { "$ref": "#/$defs/ruleKey" },
        "ruleType": {
          "enum": ["ALL", "ANY", "K_OF_N", "WEIGHTED_THRESHOLD", "MANDATORY_FLOOR"]
        },
        "title": { "$ref": "#/$defs/titleText" },
        "criticality": { "enum": ["MANDATORY", "PREFERRED", "DIFFERENTIATING"] },
        "explanation": { "$ref": "#/$defs/explanationText" },
        "accessibilityLabel": { "$ref": "#/$defs/explanationText" },
        "requiredCount": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 1000 },
            { "type": "null" }
          ]
        },
        "threshold": {
          "oneOf": [{ "$ref": "#/$defs/unitIntervalExclusiveZero" }, { "type": "null" }]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nodeRequirementMember" },
              { "$ref": "#/$defs/ruleRequirementMember" }
            ]
          }
        }
      }
    },
    "nodeRequirementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberType",
        "nodeScope",
        "nodeType",
        "nodeRef",
        "dimension",
        "requiredLevel",
        "weight"
      ],
      "properties": {
        "memberType": { "const": "NODE" },
        "nodeScope": { "enum": ["canonical", "workspace_overlay"] },
        "nodeType": { "enum": ["DOMAIN", "COMPETENCY"] },
        "nodeRef": { "$ref": "#/$defs/nodeRef" },
        "dimension": { "enum": ["KNOWLEDGE", "RECALL", "APPLICATION", "INTERVIEW_EXECUTION"] },
        "requiredLevel": { "enum": ["COMPLETED", "VERIFIED", "MASTERED"] },
        "weight": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }]
        }
      }
    },
    "ruleRequirementMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memberType", "ruleKey", "weight"],
      "properties": {
        "memberType": { "const": "RULE" },
        "ruleKey": { "$ref": "#/$defs/ruleKey" },
        "weight": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCanonicalNodeRefs",
        "requiredOverlayNodeRefs",
        "roadmapNodeRefs",
        "prerequisiteClosureNodeRefs",
        "canonicalNodes",
        "canonicalEdges",
        "requiredOverlayNodes"
      ],
      "properties": {
        "requiredCanonicalNodeRefs": { "$ref": "#/$defs/nodeRefArray" },
        "requiredOverlayNodeRefs": { "$ref": "#/$defs/competencyRefArray" },
        "roadmapNodeRefs": { "$ref": "#/$defs/nodeRefArray" },
        "prerequisiteClosureNodeRefs": { "$ref": "#/$defs/competencyRefArray" },
        "canonicalNodes": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/canonicalNode" }
        },
        "canonicalEdges": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/canonicalEdge" }
        },
        "requiredOverlayNodes": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/overlayNode" }
        }
      }
    },
    "canonicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeRef", "nodeType", "title", "description", "domainRef"],
      "properties": {
        "nodeRef": { "$ref": "#/$defs/nodeRef" },
        "nodeType": { "enum": ["DOMAIN", "COMPETENCY"] },
        "title": { "$ref": "#/$defs/titleText" },
        "description": { "$ref": "#/$defs/explanationText" },
        "domainRef": {
          "oneOf": [{ "$ref": "#/$defs/domainRef" }, { "type": "null" }]
        }
      }
    },
    "canonicalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeKey", "edgeType", "sourceRef", "targetRef", "blocking", "rationale"],
      "properties": {
        "edgeKey": {
          "type": "string",
          "pattern": "^edge:prerequisite:[a-z0-9][a-z0-9:-]{3,150}$"
        },
        "edgeType": { "const": "PREREQUISITE_OF" },
        "sourceRef": { "$ref": "#/$defs/competencyRef" },
        "targetRef": { "$ref": "#/$defs/competencyRef" },
        "blocking": { "const": true },
        "rationale": { "$ref": "#/$defs/explanationText" }
      }
    },
    "overlayNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeRef", "nodeType", "title", "domainRef", "workspaceId"],
      "properties": {
        "nodeRef": { "$ref": "#/$defs/competencyRef" },
        "nodeType": { "const": "COMPETENCY" },
        "title": { "$ref": "#/$defs/titleText" },
        "domainRef": { "$ref": "#/$defs/domainRef" },
        "workspaceId": { "type": "string", "format": "uuid" }
      }
    },
    "nodeRefArray": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/nodeRef" }
    },
    "competencyRefArray": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/competencyRef" }
    },
    "readinessGoalKey": {
      "type": "string",
      "pattern": "^goal:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "profileVersionKey": {
      "type": "string",
      "pattern": "^target:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "catalogVersionKey": {
      "type": "string",
      "pattern": "^catalog:[a-z0-9][a-z0-9-]{1,79}$"
    },
    "roadmapVersionKey": {
      "type": "string",
      "pattern": "^roadmap:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "ruleKey": {
      "type": "string",
      "pattern": "^rule:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "nodeRef": {
      "type": "string",
      "pattern": "^(domain|competency):[a-z0-9][a-z0-9-]{1,100}$"
    },
    "domainRef": {
      "type": "string",
      "pattern": "^domain:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "competencyRef": {
      "type": "string",
      "pattern": "^competency:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "positiveBigint": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "nonNegativeBigint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "unitIntervalExclusiveZero": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "titleText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F<>]+$"
    },
    "explanationText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001F\\u007F<>]+$"
    }
  }
}
