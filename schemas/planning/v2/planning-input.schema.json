{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/planning/v2/planning-input.schema.json",
  "title": "PlanningCalculationInputV2",
  "description": "Bounded, privacy-minimized owner-query input for planner-engine/0.2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputFingerprint",
    "completedWorkPolicyVersion",
    "prerequisiteEngineVersion",
    "prerequisitePolicyVersion",
    "evaluationHorizon",
    "sourceRevisions",
    "growthPlan",
    "campaign",
    "sessionLimitMinutes",
    "energyPreference",
    "activeFocus",
    "readiness",
    "reviewSummary",
    "candidates"
  ],
  "properties": {
    "inputFingerprint": {
      "type": "string",
      "pattern": "^planning-input:[a-f0-9]{64}$"
    },
    "completedWorkPolicyVersion": {
      "const": "planning-completed-work/0.2"
    },
    "prerequisiteEngineVersion": {
      "type": "string",
      "pattern": "^mastery-prerequisite-engine/[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "prerequisitePolicyVersion": {
      "type": "string",
      "pattern": "^mastery-prerequisite-satisfaction/[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "evaluationHorizon": {
      "$ref": "#/$defs/evaluationHorizon"
    },
    "sourceRevisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/sourceRevision"
      }
    },
    "growthPlan": {
      "oneOf": [
        {
          "$ref": "#/$defs/growthPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "campaign": {
      "oneOf": [
        {
          "$ref": "#/$defs/campaign"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionLimitMinutes": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        {
          "type": "null"
        }
      ]
    },
    "energyPreference": {
      "oneOf": [
        {
          "$ref": "#/$defs/energy"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeFocus": {
      "oneOf": [
        {
          "$ref": "#/$defs/activeFocus"
        },
        {
          "type": "null"
        }
      ]
    },
    "readiness": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/currentReadiness"
          },
          {
            "$ref": "#/$defs/unavailableReadiness"
          }
        ]
      }
    },
    "reviewSummary": {
      "$ref": "#/$defs/reviewSummary"
    },
    "candidates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "positiveBigint": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "goalKey": {
      "type": "string",
      "pattern": "^goal:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "trackKey": {
      "type": "string",
      "pattern": "^track:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "profileVersionKey": {
      "type": "string",
      "pattern": "^target:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "activityKey": {
      "type": "string",
      "pattern": "^activity:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "candidateKey": {
      "type": "string",
      "pattern": "^candidate:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "competencyRef": {
      "type": "string",
      "pattern": "^competency:[a-z0-9][a-z0-9-]{1,100}$"
    },
    "dimension": {
      "enum": [
        "KNOWLEDGE",
        "RECALL",
        "APPLICATION",
        "INTERVIEW_EXECUTION"
      ]
    },
    "energy": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "evaluationHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOf",
        "validUntil",
        "timeZone",
        "weekStart",
        "weekEnd"
      ],
      "properties": {
        "asOf": {
          "$ref": "#/$defs/instant"
        },
        "validUntil": {
          "$ref": "#/$defs/instant"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z0-9._+-]+)+)$"
        },
        "weekStart": {
          "$ref": "#/$defs/instant"
        },
        "weekEnd": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "key",
        "revision"
      ],
      "properties": {
        "owner": {
          "enum": [
            "CATALOG",
            "EVIDENCE",
            "FOCUS",
            "MASTERY",
            "OVERLAY",
            "REVIEW"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "trackKey",
        "title",
        "version",
        "readinessGoalKey",
        "targetProfileVersionKey",
        "lifecycle",
        "priority",
        "protectedMinimumMinutes",
        "meaningfulMinutesThisWeek",
        "defaultSessionMinutes",
        "cadencePerWeek",
        "completedCadenceSessionsThisWeek"
      ],
      "properties": {
        "trackId": {
          "$ref": "#/$defs/uuid"
        },
        "trackKey": {
          "$ref": "#/$defs/trackKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "$ref": "#/$defs/positiveBigint"
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "targetProfileVersionKey": {
          "$ref": "#/$defs/profileVersionKey"
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "PAUSED",
            "COMPLETED"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "protectedMinimumMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "meaningfulMinutesThisWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "defaultSessionMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "cadencePerWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "completedCadenceSessionsThisWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        }
      }
    },
    "growthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "growthPlanId",
        "version",
        "lifecycle",
        "weeklyCapacityMinutes",
        "consumedMinutesThisWeek",
        "tracks"
      ],
      "properties": {
        "growthPlanId": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "$ref": "#/$defs/positiveBigint"
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "PAUSED"
          ]
        },
        "weeklyCapacityMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "consumedMinutesThisWeek": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "version",
        "title",
        "readinessGoalKey",
        "targetProfileVersionKey",
        "deadlineAt"
      ],
      "properties": {
        "campaignId": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "$ref": "#/$defs/positiveBigint"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "targetProfileVersionKey": {
          "$ref": "#/$defs/profileVersionKey"
        },
        "deadlineAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "ruleKey"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
        },
        "ruleKey": {
          "type": "string",
          "pattern": "^rule:[a-z0-9][a-z0-9-]{1,100}$"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gapCode",
        "competencyRef",
        "dimension"
      ],
      "properties": {
        "gapCode": {
          "enum": [
            "FAILED_MANDATORY_FLOOR",
            "UNKNOWN_MANDATORY_FLOOR",
            "UNKNOWN_REQUIREMENT",
            "KNOWN_SHORTFALL"
          ]
        },
        "competencyRef": {
          "$ref": "#/$defs/competencyRef"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "currentReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reason",
        "readinessGoalKey",
        "targetProfileVersionKey",
        "snapshotId",
        "inputFingerprint",
        "calculatedAsOf",
        "validUntil",
        "status",
        "coverage",
        "confidence",
        "blockers",
        "gaps"
      ],
      "properties": {
        "availability": {
          "const": "CURRENT"
        },
        "reason": {
          "type": "null"
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "targetProfileVersionKey": {
          "$ref": "#/$defs/profileVersionKey"
        },
        "snapshotId": {
          "$ref": "#/$defs/uuid"
        },
        "inputFingerprint": {
          "type": "string",
          "pattern": "^readiness-input:[a-f0-9]{64}$"
        },
        "calculatedAsOf": {
          "$ref": "#/$defs/instant"
        },
        "validUntil": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "NOT_READY",
            "INSUFFICIENT_EVIDENCE",
            "READY",
            "DEVELOPING"
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "blockers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 250,
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "unavailableReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reason",
        "readinessGoalKey",
        "targetProfileVersionKey",
        "snapshotId",
        "inputFingerprint",
        "calculatedAsOf",
        "validUntil",
        "status",
        "coverage",
        "confidence",
        "blockers",
        "gaps"
      ],
      "properties": {
        "availability": {
          "const": "UNAVAILABLE"
        },
        "reason": {
          "enum": [
            "GOAL_INACTIVE",
            "NOT_MATERIALIZED",
            "REBUILDING",
            "STALE",
            "ERROR"
          ]
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "targetProfileVersionKey": {
          "$ref": "#/$defs/profileVersionKey"
        },
        "snapshotId": {
          "type": "null"
        },
        "inputFingerprint": {
          "type": "null"
        },
        "calculatedAsOf": {
          "type": "null"
        },
        "validUntil": {
          "type": "null"
        },
        "status": {
          "type": "null"
        },
        "coverage": {
          "type": "null"
        },
        "confidence": {
          "type": "null"
        },
        "blockers": {
          "type": "array",
          "maxItems": 0
        },
        "gaps": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "reviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionState",
        "overdueCount",
        "dueTodayCount",
        "validUntil"
      ],
      "properties": {
        "projectionState": {
          "enum": [
            "CURRENT",
            "PENDING",
            "NOT_STARTED"
          ]
        },
        "overdueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dueTodayCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "validUntil": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "activeFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusSessionId",
        "readinessGoalKey",
        "activityKey",
        "title",
        "plannedMinutes",
        "startedAt",
        "planAttribution"
      ],
      "properties": {
        "focusSessionId": {
          "$ref": "#/$defs/uuid"
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "activityKey": {
          "$ref": "#/$defs/activityKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "plannedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "startedAt": {
          "$ref": "#/$defs/instant"
        },
        "planAttribution": {
          "oneOf": [
            {
              "$ref": "#/$defs/planAttribution"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "planAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSnapshotId",
        "candidateKey",
        "trackId"
      ],
      "properties": {
        "planSnapshotId": {
          "$ref": "#/$defs/uuid"
        },
        "candidateKey": {
          "$ref": "#/$defs/candidateKey"
        },
        "trackId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reviewSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewItemId",
        "bucket",
        "dueAt"
      ],
      "properties": {
        "reviewItemId": {
          "$ref": "#/$defs/uuid"
        },
        "bucket": {
          "enum": [
            "OVERDUE",
            "DUE_TODAY"
          ]
        },
        "dueAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyRef",
        "dimension"
      ],
      "properties": {
        "competencyRef": {
          "$ref": "#/$defs/competencyRef"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKey",
        "readinessGoalKey",
        "targetProfileVersionKey",
        "activityKey",
        "title",
        "estimatedMinutes",
        "energy",
        "durationSource",
        "sourceSignals",
        "trackId",
        "competencyImpacts",
        "prerequisiteState",
        "prerequisiteSummary",
        "unlockCount",
        "repetitionsInLast7Days",
        "oldestRepetitionEndedAt",
        "repetitionWindowEndsAt",
        "review"
      ],
      "properties": {
        "candidateKey": {
          "$ref": "#/$defs/candidateKey"
        },
        "readinessGoalKey": {
          "$ref": "#/$defs/goalKey"
        },
        "targetProfileVersionKey": {
          "$ref": "#/$defs/profileVersionKey"
        },
        "activityKey": {
          "$ref": "#/$defs/activityKey"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "energy": {
          "oneOf": [
            {
              "$ref": "#/$defs/energy"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSource": {
          "enum": [
            "PLANNING_ACTIVITY",
            "REVIEW_POLICY"
          ]
        },
        "sourceSignals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GROWTH_PLAN",
              "CAMPAIGN",
              "REVIEW"
            ]
          }
        },
        "trackId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "competencyImpacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/impact"
          }
        },
        "prerequisiteState": {
          "enum": [
            "SATISFIED",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "prerequisiteSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "satisfied",
            "blocked",
            "unknown"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "satisfied": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "unlockCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "repetitionsInLast7Days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "oldestRepetitionEndedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "repetitionWindowEndsAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "oneOf": [
            {
              "$ref": "#/$defs/reviewSignal"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
