{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/planning/v1/growth-plan-control.schema.json",
  "title": "PANDO Growth Plan Control V1",
  "oneOf": [
    { "$ref": "#/$defs/currentGrowthPlan" },
    { "$ref": "#/$defs/lifecyclePreview" },
    { "$ref": "#/$defs/lifecycleApplyResult" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,198}\\S)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$"
    },
    "operation": {
      "enum": ["pause_growth_plan", "resume_growth_plan"]
    },
    "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
    "contractCurrent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "CurrentGrowthPlanV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "GrowthPlanLifecyclePreviewV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractApply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "GrowthPlanLifecycleApplyResultV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "planState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "growthPlanId",
        "title",
        "lifecycle",
        "weeklyCapacityMinutes",
        "aggregateVersion"
      ],
      "properties": {
        "growthPlanId": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "weeklyCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "recalculation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectionState", "reason", "lastKnownSafe"],
          "properties": {
            "projectionState": { "const": "CURRENT" },
            "reason": { "type": "null" },
            "lastKnownSafe": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectionState", "reason", "lastKnownSafe"],
          "properties": {
            "projectionState": { "const": "PENDING" },
            "reason": { "enum": ["INPUTS_CHANGED", "SNAPSHOT_EXPIRED"] },
            "lastKnownSafe": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectionState", "reason", "lastKnownSafe"],
          "properties": {
            "projectionState": { "const": "ERROR" },
            "reason": { "const": "CALCULATION_FAILED" },
            "lastKnownSafe": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectionState", "reason", "lastKnownSafe"],
          "properties": {
            "projectionState": { "const": "NOT_STARTED" },
            "reason": { "const": "INITIALIZING" },
            "lastKnownSafe": { "const": false }
          }
        }
      ]
    },
    "currentGrowthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "currentPlan", "recalculation", "capabilities"],
      "properties": {
        "contract": { "$ref": "#/$defs/contractCurrent" },
        "currentPlan": {
          "anyOf": [{ "$ref": "#/$defs/planState" }, { "type": "null" }]
        },
        "recalculation": { "$ref": "#/$defs/recalculation" },
        "capabilities": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "lifecyclePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "operation",
        "reason",
        "expectedGrowthPlanVersion",
        "before",
        "after",
        "retained",
        "recalculationAfterApply",
        "previewDigest"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractPreview" },
        "operation": { "$ref": "#/$defs/operation" },
        "reason": { "$ref": "#/$defs/reason" },
        "expectedGrowthPlanVersion": { "$ref": "#/$defs/positiveBigint" },
        "before": { "$ref": "#/$defs/planState" },
        "after": { "$ref": "#/$defs/planState" },
        "retained": {
          "type": "object",
          "additionalProperties": false,
          "required": ["learningTracks", "planSnapshots", "focusSessions", "evidence"],
          "properties": {
            "learningTracks": { "const": true },
            "planSnapshots": { "const": true },
            "focusSessions": { "const": true },
            "evidence": { "const": true }
          }
        },
        "recalculationAfterApply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectionState", "consumerName"],
          "properties": {
            "projectionState": { "const": "PENDING" },
            "consumerName": { "const": "planning.plan_snapshot_v1" }
          }
        },
        "previewDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "lifecycleApplyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "commandId",
        "changedPlan",
        "projectionState",
        "planningDeliveryId",
        "emittedEventIds"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractApply" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "changedPlan": { "$ref": "#/$defs/planState" },
        "projectionState": { "const": "PENDING" },
        "planningDeliveryId": { "$ref": "#/$defs/uuid" },
        "emittedEventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
