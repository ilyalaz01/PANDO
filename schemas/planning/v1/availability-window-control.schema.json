{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/planning/v1/availability-window-control.schema.json",
  "title": "PANDO Availability Window Control V1",
  "oneOf": [
    { "$ref": "#/$defs/availabilityAvailable" },
    { "$ref": "#/$defs/availabilityUnavailable" },
    { "$ref": "#/$defs/availabilityPreview" },
    { "$ref": "#/$defs/availabilityApplyResult" }
  ],
  "$defs": {
    "uuidV8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuid": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "windowKey": {
      "type": "string",
      "pattern": "^window:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "localDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,118}\\S)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$"
    },
    "energy": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "operation": {
      "enum": [
        "create_availability_window",
        "change_availability_window",
        "remove_availability_window"
      ]
    },
    "contractSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "AvailabilityWindowSourceV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "AvailabilityWindowPreviewV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractApply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "AvailabilityWindowApplyResultV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "windowState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowKey",
        "startsOn",
        "endsOn",
        "timeZone",
        "availableMinutes",
        "energy",
        "label",
        "lifecycle",
        "aggregateVersion"
      ],
      "properties": {
        "windowKey": { "$ref": "#/$defs/windowKey" },
        "startsOn": { "$ref": "#/$defs/localDate" },
        "endsOn": { "$ref": "#/$defs/localDate" },
        "timeZone": { "$ref": "#/$defs/timeZone" },
        "availableMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "energy": { "oneOf": [{ "$ref": "#/$defs/energy" }, { "type": "null" }] },
        "label": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "lifecycle": { "enum": ["ACTIVE", "REMOVED"] },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "previewWindowState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowKey",
        "availabilityWindowId",
        "startsOn",
        "endsOn",
        "timeZone",
        "availableMinutes",
        "energy",
        "label",
        "lifecycle",
        "aggregateVersion"
      ],
      "properties": {
        "windowKey": { "$ref": "#/$defs/windowKey" },
        "availabilityWindowId": { "$ref": "#/$defs/uuidV8" },
        "startsOn": { "$ref": "#/$defs/localDate" },
        "endsOn": { "$ref": "#/$defs/localDate" },
        "timeZone": { "$ref": "#/$defs/timeZone" },
        "availableMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "energy": { "oneOf": [{ "$ref": "#/$defs/energy" }, { "type": "null" }] },
        "label": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "lifecycle": { "enum": ["ACTIVE", "REMOVED"] },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "sourceGrowthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "weeklyCapacityMinutes",
        "aggregateVersion",
        "timeZone",
        "currentLocalDate",
        "activeWindowCount",
        "activeWindowLimit",
        "removedWindowCount",
        "capacityUsesAvailability"
      ],
      "properties": {
        "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
        "weeklyCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" },
        "timeZone": { "$ref": "#/$defs/timeZone" },
        "currentLocalDate": { "$ref": "#/$defs/localDate" },
        "activeWindowCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "activeWindowLimit": { "const": 60 },
        "removedWindowCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "capacityUsesAvailability": { "type": "boolean" }
      }
    },
    "availabilityAvailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "state",
        "capabilities",
        "growthPlan",
        "availabilityWindows",
        "removedAvailabilityWindows"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractSource" },
        "state": { "enum": ["AVAILABILITY_AVAILABLE", "WINDOW_LIMIT_REACHED"] },
        "capabilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        },
        "growthPlan": { "$ref": "#/$defs/sourceGrowthPlan" },
        "availabilityWindows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 60,
          "items": { "$ref": "#/$defs/windowState" }
        },
        "removedAvailabilityWindows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/windowState" }
        }
      }
    },
    "availabilityUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "state",
        "capabilities",
        "growthPlan",
        "availabilityWindows",
        "removedAvailabilityWindows"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractSource" },
        "state": { "const": "NO_CURRENT_PLAN" },
        "capabilities": { "type": "array", "maxItems": 0 },
        "growthPlan": { "type": "null" },
        "availabilityWindows": { "type": "array", "maxItems": 0 },
        "removedAvailabilityWindows": { "type": "array", "maxItems": 0 }
      }
    },
    "previewGrowthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["growthPlanId", "lifecycle", "weeklyCapacityMinutes", "aggregateVersion"],
      "properties": {
        "growthPlanId": { "$ref": "#/$defs/uuid" },
        "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
        "weeklyCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "previewBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeWindowCount", "removedWindowCount", "activeWindowFingerprint", "window"],
      "properties": {
        "activeWindowCount": { "type": "integer", "minimum": 0, "maximum": 60 },
        "removedWindowCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "activeWindowFingerprint": { "$ref": "#/$defs/digest" },
        "window": {
          "oneOf": [{ "$ref": "#/$defs/previewWindowState" }, { "type": "null" }]
        }
      }
    },
    "previewAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeWindowCount", "window"],
      "properties": {
        "activeWindowCount": { "type": "integer", "minimum": 0, "maximum": 61 },
        "window": { "$ref": "#/$defs/previewWindowState" }
      }
    },
    "blockingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "AVAILABILITY_WINDOW_OVERLAPS_EXISTING",
            "AVAILABILITY_WINDOW_LIMIT_REACHED",
            "AVAILABILITY_WINDOW_ALREADY_REMOVED",
            "PLANNING_CREATE_IDENTITY_COLLISION"
          ]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["AVAILABILITY_NOT_YET_APPLIED_TO_CAPACITY", "AVAILABILITY_WINDOW_IN_THE_PAST"]
        }
      }
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "growthPlan",
        "learningTracks",
        "activitiesAndEvidence",
        "mastery",
        "reviews",
        "planSnapshots"
      ],
      "properties": {
        "growthPlan": { "const": true },
        "learningTracks": { "const": true },
        "activitiesAndEvidence": { "const": true },
        "mastery": { "const": true },
        "reviews": { "const": true },
        "planSnapshots": { "const": true }
      }
    },
    "recalculationAfterApply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionState", "eventChangeKind", "consumerName"],
      "properties": {
        "projectionState": { "const": "PENDING" },
        "eventChangeKind": { "const": "AVAILABILITY_CHANGED" },
        "consumerName": { "const": "planning.plan_snapshot_v1" }
      }
    },
    "availabilityPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "digestVersion",
        "identityVersion",
        "operation",
        "commandType",
        "idempotencyKey",
        "reason",
        "expectedGrowthPlanVersion",
        "growthPlan",
        "before",
        "after",
        "canApply",
        "blockingReasons",
        "warnings",
        "retained",
        "recalculationAfterApply",
        "previewDigest"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractPreview" },
        "digestVersion": { "const": "availability-window-preview-digest/1.0.0" },
        "identityVersion": { "const": "planning-create-identity/1.0.0" },
        "operation": { "$ref": "#/$defs/operation" },
        "commandType": { "const": "planning.change_availability_window_v1" },
        "idempotencyKey": { "$ref": "#/$defs/uuid" },
        "reason": { "$ref": "#/$defs/reason" },
        "expectedGrowthPlanVersion": { "$ref": "#/$defs/positiveBigint" },
        "growthPlan": { "$ref": "#/$defs/previewGrowthPlan" },
        "before": { "$ref": "#/$defs/previewBefore" },
        "after": { "$ref": "#/$defs/previewAfter" },
        "canApply": { "type": "boolean" },
        "blockingReasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/blockingReason" }
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/warning" }
        },
        "retained": { "$ref": "#/$defs/retained" },
        "recalculationAfterApply": { "$ref": "#/$defs/recalculationAfterApply" },
        "previewDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "availabilityApplyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "commandId",
        "operation",
        "availabilityWindow",
        "activeWindowCount",
        "projectionState",
        "planningDeliveryId",
        "emittedEventIds"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractApply" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "operation": { "$ref": "#/$defs/operation" },
        "availabilityWindow": { "$ref": "#/$defs/previewWindowState" },
        "activeWindowCount": { "type": "integer", "minimum": 0, "maximum": 61 },
        "projectionState": { "const": "PENDING" },
        "planningDeliveryId": { "$ref": "#/$defs/uuid" },
        "emittedEventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
