{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/planning/v1/learning-track-lifecycle-control.schema.json",
  "title": "PANDO Learning Track Lifecycle Control V1",
  "oneOf": [{ "$ref": "#/$defs/current" }, { "$ref": "#/$defs/preview" }, { "$ref": "#/$defs/applyResult" }],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "positiveBigint": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trackKey": { "type": "string", "pattern": "^track:[a-z0-9][a-z0-9-]{1,100}$" },
    "trimmed": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]{0,198}\\S)$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$" },
    "growthPlan": { "type": "object", "additionalProperties": false, "required": ["growthPlanId", "lifecycle", "weeklyCapacityMinutes", "aggregateVersion"], "properties": { "growthPlanId": { "$ref": "#/$defs/uuid" }, "lifecycle": { "enum": ["ACTIVE", "PAUSED"] }, "weeklyCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 }, "aggregateVersion": { "$ref": "#/$defs/positiveBigint" } } },
    "trackState": { "type": "object", "additionalProperties": false, "required": ["learningTrackId", "trackKey", "title", "lifecycle", "priority", "protectedMinimumMinutes", "aggregateVersion"], "properties": { "learningTrackId": { "$ref": "#/$defs/uuid" }, "trackKey": { "$ref": "#/$defs/trackKey" }, "title": { "$ref": "#/$defs/trimmed" }, "lifecycle": { "enum": ["ACTIVE", "PAUSED"] }, "priority": { "type": "integer", "minimum": 0, "maximum": 100 }, "protectedMinimumMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 }, "aggregateVersion": { "$ref": "#/$defs/positiveBigint" } } },
    "trackSummary": { "type": "object", "additionalProperties": false, "required": ["learningTrackId", "trackKey", "title", "lifecycle", "priority", "protectedMinimumMinutes", "aggregateVersion", "capabilities"], "properties": { "learningTrackId": { "$ref": "#/$defs/uuid" }, "trackKey": { "$ref": "#/$defs/trackKey" }, "title": { "$ref": "#/$defs/trimmed" }, "lifecycle": { "enum": ["ACTIVE", "PAUSED"] }, "priority": { "type": "integer", "minimum": 0, "maximum": 100 }, "protectedMinimumMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 }, "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }, "capabilities": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["pause_track", "resume_track"] } } } },
    "constraint": { "type": "object", "additionalProperties": false, "required": ["activeTrackCountBefore", "activeTrackCountAfter", "activeProtectedMinimumMinutesBefore", "activeProtectedMinimumMinutesAfter", "flexibleMinutesBefore", "flexibleMinutesAfter", "activeTrackFingerprintBefore", "activeTrackFingerprintAfter"], "properties": { "activeTrackCountBefore": { "type": "integer", "minimum": 0, "maximum": 30 }, "activeTrackCountAfter": { "type": "integer", "minimum": 0, "maximum": 31 }, "activeProtectedMinimumMinutesBefore": { "type": "integer", "minimum": 0, "maximum": 10080 }, "activeProtectedMinimumMinutesAfter": { "type": "integer", "minimum": 0, "maximum": 20160 }, "flexibleMinutesBefore": { "type": "integer", "minimum": 0, "maximum": 10080 }, "flexibleMinutesAfter": { "type": "integer", "minimum": -10080, "maximum": 10080 }, "activeTrackFingerprintBefore": { "$ref": "#/$defs/digest" }, "activeTrackFingerprintAfter": { "$ref": "#/$defs/digest" } } },
    "blockingReason": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["code", "maximumActiveTracks"], "properties": { "code": { "const": "ACTIVE_TRACK_LIMIT_EXCEEDED" }, "maximumActiveTracks": { "const": 30 } } }, { "type": "object", "additionalProperties": false, "required": ["code", "minimumCapacityMinutes"], "properties": { "code": { "const": "ACTIVE_TRACK_MINIMUM_EXCEEDS_CAPACITY" }, "minimumCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 } } }] },
    "retained": { "type": "object", "additionalProperties": false, "required": ["learningTrackActivities", "planSnapshots", "focusSessions", "evidence"], "properties": { "learningTrackActivities": { "const": true }, "planSnapshots": { "const": true }, "focusSessions": { "const": true }, "evidence": { "const": true } } },
    "recalculation": { "type": "object", "additionalProperties": false, "required": ["projectionState", "consumerName"], "properties": { "projectionState": { "const": "PENDING" }, "consumerName": { "const": "planning.plan_snapshot_v1" } } },
    "current": { "type": "object", "additionalProperties": false, "required": ["contract", "growthPlan", "learningTracks"], "properties": { "contract": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "CurrentLearningTracksV1" }, "version": { "const": "1.0.0" } } }, "growthPlan": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/growthPlan" }] }, "learningTracks": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/trackSummary" } } } },
    "preview": { "type": "object", "additionalProperties": false, "required": ["contract", "operation", "reason", "expectedGrowthPlanVersion", "expectedLearningTrackVersion", "growthPlan", "before", "after", "constraint", "canApply", "blockingReasons", "warnings", "retained", "recalculationAfterApply", "previewDigest"], "properties": { "contract": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "LearningTrackLifecyclePreviewV1" }, "version": { "const": "1.0.0" } } }, "operation": { "enum": ["pause_track", "resume_track"] }, "reason": { "$ref": "#/$defs/reason" }, "expectedGrowthPlanVersion": { "$ref": "#/$defs/positiveBigint" }, "expectedLearningTrackVersion": { "$ref": "#/$defs/positiveBigint" }, "growthPlan": { "$ref": "#/$defs/growthPlan" }, "before": { "$ref": "#/$defs/trackState" }, "after": { "$ref": "#/$defs/trackState" }, "constraint": { "$ref": "#/$defs/constraint" }, "canApply": { "type": "boolean" }, "blockingReasons": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/blockingReason" } }, "warnings": { "type": "array", "maxItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "const": "PARENT_GROWTH_PLAN_PAUSED" } } } }, "retained": { "$ref": "#/$defs/retained" }, "recalculationAfterApply": { "$ref": "#/$defs/recalculation" }, "previewDigest": { "$ref": "#/$defs/digest" } } },
    "applyResult": { "type": "object", "additionalProperties": false, "required": ["contract", "commandId", "changedTrack", "projectionState", "planningDeliveryId", "emittedEventIds"], "properties": { "contract": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "LearningTrackLifecycleApplyResultV1" }, "version": { "const": "1.0.0" } } }, "commandId": { "$ref": "#/$defs/uuid" }, "changedTrack": { "$ref": "#/$defs/trackState" }, "projectionState": { "const": "PENDING" }, "planningDeliveryId": { "$ref": "#/$defs/uuid" }, "emittedEventIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } } } }
  }
}
