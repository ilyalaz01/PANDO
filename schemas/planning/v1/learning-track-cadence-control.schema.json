{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/planning/v1/learning-track-cadence-control.schema.json",
  "title": "PANDO Learning Track Cadence Control V1",
  "oneOf": [
    { "$ref": "#/$defs/source" },
    { "$ref": "#/$defs/preview" },
    { "$ref": "#/$defs/applyResult" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputFingerprint": { "type": "string", "pattern": "^planning-input:[a-f0-9]{64}$" },
    "trackKey": { "type": "string", "pattern": "^track:[a-z0-9][a-z0-9-]{1,100}$" },
    "trimmed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,158}\\S)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$"
    },
    "growthPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["growthPlanId", "lifecycle", "weeklyCapacityMinutes", "aggregateVersion"],
      "properties": {
        "growthPlanId": { "$ref": "#/$defs/uuid" },
        "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
        "weeklyCapacityMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "trackState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningTrackId",
        "trackKey",
        "title",
        "lifecycle",
        "priority",
        "protectedMinimumMinutes",
        "cadencePerWeek",
        "aggregateVersion"
      ],
      "properties": {
        "learningTrackId": { "$ref": "#/$defs/uuid" },
        "trackKey": { "$ref": "#/$defs/trackKey" },
        "title": { "$ref": "#/$defs/trimmed" },
        "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "protectedMinimumMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "cadencePerWeek": { "type": "integer", "minimum": 0, "maximum": 100 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "progressIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "snapshotId", "appliedAttemptId", "inputFingerprint", "calculatedAsOf"],
          "properties": {
            "state": { "const": "CURRENT" },
            "snapshotId": { "$ref": "#/$defs/uuid" },
            "appliedAttemptId": { "$ref": "#/$defs/uuid" },
            "inputFingerprint": { "$ref": "#/$defs/inputFingerprint" },
            "calculatedAsOf": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "snapshotId", "appliedAttemptId", "inputFingerprint", "calculatedAsOf"],
          "properties": {
            "state": { "enum": ["PENDING", "UNAVAILABLE"] },
            "snapshotId": { "type": "null" },
            "appliedAttemptId": { "type": "null" },
            "inputFingerprint": { "type": "null" },
            "calculatedAsOf": { "type": "null" }
          }
        }
      ]
    },
    "sourceTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningTrackId",
        "trackKey",
        "title",
        "lifecycle",
        "priority",
        "protectedMinimumMinutes",
        "cadencePerWeek",
        "aggregateVersion",
        "completedCadenceSessionsThisWeek",
        "capabilities"
      ],
      "properties": {
        "learningTrackId": { "$ref": "#/$defs/uuid" },
        "trackKey": { "$ref": "#/$defs/trackKey" },
        "title": { "$ref": "#/$defs/trimmed" },
        "lifecycle": { "enum": ["ACTIVE", "PAUSED"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "protectedMinimumMinutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
        "cadencePerWeek": { "type": "integer", "minimum": 0, "maximum": 100 },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" },
        "completedCadenceSessionsThisWeek": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 500
        },
        "capabilities": {
          "type": "array",
          "prefixItems": [{ "const": "set_track_cadence" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "growthPlan", "progress", "learningTracks"],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "LearningTrackCadenceSourceV1" },
            "version": { "const": "1.0.0" }
          }
        },
        "growthPlan": { "oneOf": [{ "$ref": "#/$defs/growthPlan" }, { "type": "null" }] },
        "progress": { "$ref": "#/$defs/progressIdentity" },
        "learningTracks": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/sourceTrack" }
        }
      }
    },
    "previewProgress": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "snapshotId",
            "appliedAttemptId",
            "inputFingerprint",
            "calculatedAsOf",
            "completedCadenceSessionsThisWeek",
            "beforeCadenceDeficit",
            "afterCadenceDeficit"
          ],
          "properties": {
            "state": { "const": "CURRENT" },
            "snapshotId": { "$ref": "#/$defs/uuid" },
            "appliedAttemptId": { "$ref": "#/$defs/uuid" },
            "inputFingerprint": { "$ref": "#/$defs/inputFingerprint" },
            "calculatedAsOf": { "type": "string", "format": "date-time" },
            "completedCadenceSessionsThisWeek": { "type": "integer", "minimum": 0, "maximum": 500 },
            "beforeCadenceDeficit": { "type": "integer", "minimum": 0, "maximum": 100 },
            "afterCadenceDeficit": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "snapshotId",
            "appliedAttemptId",
            "inputFingerprint",
            "calculatedAsOf",
            "completedCadenceSessionsThisWeek",
            "beforeCadenceDeficit",
            "afterCadenceDeficit"
          ],
          "properties": {
            "state": { "enum": ["PENDING", "UNAVAILABLE"] },
            "snapshotId": { "type": "null" },
            "appliedAttemptId": { "type": "null" },
            "inputFingerprint": { "type": "null" },
            "calculatedAsOf": { "type": "null" },
            "completedCadenceSessionsThisWeek": { "type": "null" },
            "beforeCadenceDeficit": { "type": "null" },
            "afterCadenceDeficit": { "type": "null" }
          }
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["PARENT_GROWTH_PLAN_PAUSED", "LEARNING_TRACK_PAUSED", "CADENCE_PROGRESS_PENDING"]
        }
      }
    },
    "unchanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "protectedMinimumMinutes",
        "learningTrackActivities",
        "planSnapshots",
        "focusSessions",
        "evidence",
        "masteryAndReadiness",
        "review"
      ],
      "properties": {
        "priority": { "const": true },
        "protectedMinimumMinutes": { "const": true },
        "learningTrackActivities": { "const": true },
        "planSnapshots": { "const": true },
        "focusSessions": { "const": true },
        "evidence": { "const": true },
        "masteryAndReadiness": { "const": true },
        "review": { "const": true }
      }
    },
    "recalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionState", "consumerName"],
      "properties": {
        "projectionState": { "const": "PENDING" },
        "consumerName": { "const": "planning.plan_snapshot_v1" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "operation",
        "reason",
        "expectedGrowthPlanVersion",
        "expectedLearningTrackVersion",
        "growthPlan",
        "before",
        "after",
        "progress",
        "canApply",
        "blockingReasons",
        "warnings",
        "unchanged",
        "recalculationAfterApply",
        "previewDigest"
      ],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "LearningTrackCadencePreviewV1" },
            "version": { "const": "1.0.0" }
          }
        },
        "operation": { "const": "set_track_cadence" },
        "reason": { "$ref": "#/$defs/reason" },
        "expectedGrowthPlanVersion": { "$ref": "#/$defs/positiveBigint" },
        "expectedLearningTrackVersion": { "$ref": "#/$defs/positiveBigint" },
        "growthPlan": { "$ref": "#/$defs/growthPlan" },
        "before": { "$ref": "#/$defs/trackState" },
        "after": { "$ref": "#/$defs/trackState" },
        "progress": { "$ref": "#/$defs/previewProgress" },
        "canApply": { "const": true },
        "blockingReasons": { "type": "array", "maxItems": 0 },
        "warnings": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/warning" }
        },
        "unchanged": { "$ref": "#/$defs/unchanged" },
        "recalculationAfterApply": { "$ref": "#/$defs/recalculation" },
        "previewDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "applyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "commandId",
        "changedTrack",
        "projectionState",
        "planningDeliveryId",
        "emittedEventIds"
      ],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "LearningTrackCadenceApplyResultV1" },
            "version": { "const": "1.0.0" }
          }
        },
        "commandId": { "$ref": "#/$defs/uuid" },
        "changedTrack": { "$ref": "#/$defs/trackState" },
        "projectionState": { "const": "PENDING" },
        "planningDeliveryId": { "$ref": "#/$defs/uuid" },
        "emittedEventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
