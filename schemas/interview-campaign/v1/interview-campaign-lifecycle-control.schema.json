{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/interview-campaign/v1/interview-campaign-lifecycle-control.schema.json",
  "title": "PANDO Interview Campaign Lifecycle Control V1",
  "oneOf": [
    { "$ref": "#/$defs/lifecyclePreview" },
    { "$ref": "#/$defs/lifecycleApplyResult" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "uuidV8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,198}\\S)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$"
    },
    "campaignKey": {
      "type": "string",
      "pattern": "^campaign:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": { "enum": ["start_campaign", "end_campaign", "cancel_campaign"] },
    "lifecycleBefore": { "enum": ["DRAFT", "ACTIVE"] },
    "lifecycleAfter": { "enum": ["ACTIVE", "ENDED", "CANCELLED"] },
    "contractPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "InterviewCampaignLifecyclePreviewV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractApply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "InterviewCampaignLifecycleApplyResultV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "campaignBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "campaignKey", "title", "lifecycle", "aggregateVersion"],
      "properties": {
        "campaignId": { "$ref": "#/$defs/uuidV8" },
        "campaignKey": { "$ref": "#/$defs/campaignKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "$ref": "#/$defs/lifecycleBefore" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "campaignAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "campaignKey", "title", "lifecycle", "aggregateVersion"],
      "properties": {
        "campaignId": { "$ref": "#/$defs/uuidV8" },
        "campaignKey": { "$ref": "#/$defs/campaignKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "$ref": "#/$defs/lifecycleAfter" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "lifecyclePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "operation",
        "commandType",
        "reason",
        "before",
        "after",
        "canApply",
        "blockingReasons",
        "warnings",
        "previewDigest"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractPreview" },
        "operation": { "$ref": "#/$defs/operation" },
        "commandType": { "const": "targets.change_interview_campaign_lifecycle_v1" },
        "reason": { "$ref": "#/$defs/reason" },
        "before": { "$ref": "#/$defs/campaignBefore" },
        "after": { "$ref": "#/$defs/campaignAfter" },
        "canApply": { "const": true },
        "blockingReasons": { "type": "array", "maxItems": 0 },
        "warnings": { "type": "array", "maxItems": 0 },
        "previewDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "lifecycleApplyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "commandId", "campaign", "emittedEventIds"],
      "properties": {
        "contract": { "$ref": "#/$defs/contractApply" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "campaign": { "$ref": "#/$defs/campaignAfter" },
        "emittedEventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
