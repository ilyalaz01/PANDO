{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/interview-campaign/v1/interview-campaigns.schema.json",
  "title": "PANDO Interview Campaigns V1",
  "$ref": "#/$defs/interviewCampaigns",
  "$defs": {
    "campaignKey": {
      "type": "string",
      "pattern": "^campaign:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "goalKey": { "type": "string", "pattern": "^goal:[a-z0-9][a-z0-9-]{1,100}$" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,198}\\S)$"
    },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "localDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$"
    },
    "instant": { "type": "string", "format": "date-time", "maxLength": 40 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "InterviewCampaignsV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "readinessGoalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readinessGoalKey", "title"],
      "properties": {
        "readinessGoalKey": { "$ref": "#/$defs/goalKey" },
        "title": { "$ref": "#/$defs/title" }
      }
    },
    "campaignDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDate", "timeZone", "at", "passed", "daysUntil"],
      "properties": {
        "localDate": { "$ref": "#/$defs/localDate" },
        "timeZone": { "$ref": "#/$defs/timeZone" },
        "at": { "$ref": "#/$defs/instant" },
        "passed": { "type": "boolean" },
        "daysUntil": { "type": "integer", "minimum": 0, "maximum": 36500 }
      }
    },
    "capability": {
      "enum": [
        "start_campaign",
        "end_campaign",
        "change_campaign_deadline",
        "change_campaign_target",
        "cancel_campaign"
      ]
    },
    "campaignSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignKey",
        "title",
        "lifecycle",
        "readinessGoal",
        "deadline",
        "aggregateVersion",
        "capabilities"
      ],
      "properties": {
        "campaignKey": { "$ref": "#/$defs/campaignKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "enum": ["DRAFT", "ACTIVE", "ENDED", "CANCELLED"] },
        "readinessGoal": { "$ref": "#/$defs/readinessGoalSummary" },
        "deadline": { "$ref": "#/$defs/campaignDeadline" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" },
        "capabilities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "interviewCampaigns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "campaigns"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "campaigns": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/campaignSummary" }
        }
      }
    }
  }
}
