{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pando.local/schemas/interview-campaign/v1/interview-campaign-retarget-control.schema.json",
  "title": "PANDO Interview Campaign Retarget Control V1",
  "oneOf": [
    { "$ref": "#/$defs/retargetPreview" },
    { "$ref": "#/$defs/retargetApplyResult" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "uuidV8": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positiveBigint": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,198}\\S)$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,498}\\S)$"
    },
    "goalKey": { "type": "string", "pattern": "^goal:[a-z0-9][a-z0-9-]{1,100}$" },
    "campaignKey": {
      "type": "string",
      "pattern": "^campaign:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lifecycle": { "enum": ["DRAFT", "ACTIVE"] },
    "contractPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "InterviewCampaignRetargetPreviewV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "contractApply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "InterviewCampaignRetargetApplyResultV1" },
        "version": { "const": "1.0.0" }
      }
    },
    "beforeGoalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readinessGoalId", "readinessGoalKey", "title"],
      "properties": {
        "readinessGoalId": { "$ref": "#/$defs/uuid" },
        "readinessGoalKey": { "$ref": "#/$defs/goalKey" },
        "title": { "$ref": "#/$defs/title" }
      }
    },
    "afterGoalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readinessGoalId", "readinessGoalKey", "title", "lifecycle", "aggregateVersion"],
      "properties": {
        "readinessGoalId": { "$ref": "#/$defs/uuid" },
        "readinessGoalKey": { "$ref": "#/$defs/goalKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "const": "ACTIVE" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" }
      }
    },
    "campaignBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "campaignKey",
        "title",
        "lifecycle",
        "aggregateVersion",
        "readinessGoal"
      ],
      "properties": {
        "campaignId": { "$ref": "#/$defs/uuidV8" },
        "campaignKey": { "$ref": "#/$defs/campaignKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" },
        "readinessGoal": { "$ref": "#/$defs/beforeGoalRef" }
      }
    },
    "campaignAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "campaignKey",
        "title",
        "lifecycle",
        "aggregateVersion",
        "readinessGoal",
        "revisionNumber"
      ],
      "properties": {
        "campaignId": { "$ref": "#/$defs/uuidV8" },
        "campaignKey": { "$ref": "#/$defs/campaignKey" },
        "title": { "$ref": "#/$defs/title" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "aggregateVersion": { "$ref": "#/$defs/positiveBigint" },
        "readinessGoal": { "$ref": "#/$defs/afterGoalRef" },
        "revisionNumber": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousReadinessGoal", "newReadinessGoal"],
      "properties": {
        "previousReadinessGoal": { "const": true },
        "newReadinessGoal": { "const": true }
      }
    },
    "retargetPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "operation",
        "commandType",
        "reason",
        "before",
        "after",
        "retained",
        "canApply",
        "blockingReasons",
        "warnings",
        "previewDigest"
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contractPreview" },
        "operation": { "const": "change_campaign_target" },
        "commandType": { "const": "targets.retarget_interview_campaign_v1" },
        "reason": { "$ref": "#/$defs/reason" },
        "before": { "$ref": "#/$defs/campaignBefore" },
        "after": { "$ref": "#/$defs/campaignAfter" },
        "retained": { "$ref": "#/$defs/retained" },
        "canApply": { "const": true },
        "blockingReasons": { "type": "array", "maxItems": 0 },
        "warnings": { "type": "array", "maxItems": 0 },
        "previewDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "retargetApplyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "commandId", "campaign", "emittedEventIds"],
      "properties": {
        "contract": { "$ref": "#/$defs/contractApply" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "campaign": { "$ref": "#/$defs/campaignAfter" },
        "emittedEventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    }
  }
}
