{
  "name": "pando",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PANDO evidence-first learning and planning system",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/ilyalaz01/PANDO#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyalaz01/PANDO.git"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:contracts": "vitest run tests/contract",
    "test:performance": "vitest run tests/performance",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:ci": "playwright install --with-deps chromium",
    "test:e2e": "next build && playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:performance && pnpm test:unit:coverage && pnpm test:e2e",
    "verify:db": "node scripts/database/verify-database.mjs",
    "backup:seal": "node scripts/backup/pando-backup.mjs --command seal",
    "backup:open": "node scripts/backup/pando-backup.mjs --command open",
    "verify:backup": "node scripts/backup/backup.integration.mjs",
    "verify:phase0": "pnpm verify && pnpm verify:db && pnpm verify:backup",
    "backup:r2-plan": "node scripts/backup/r2-plan.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-canonicalize": "3.0.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
