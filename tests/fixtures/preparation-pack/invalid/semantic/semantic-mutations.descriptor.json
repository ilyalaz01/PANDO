{
  "descriptor_version": "1.0.0",
  "description": "Each mutation remains structurally valid and must be rejected by semantic validation.",
  "base_pack": "valid/minimal",
  "default_integrity_isolation": "After mutating target-profile.json or preparation-plan.json, serialize with two-space indentation, LF, and one trailing LF, then recompute that file's manifest byte_length and sha256 before evaluating the named semantic rule. Manifest-only mutations preserve all non-mutated exact file descriptors.",
  "manifest_integrity_cases": ["checksum-content-mismatch", "checksum-byte-length-mismatch"],
  "cases": [
    {
      "case_id": "dangling-canonical-reference",
      "base": "valid/minimal/target-profile.json",
      "patch": [{ "op": "replace", "path": "/requirements/0/subject_ref/competency_id", "value": "competency:not-in-context" }],
      "expected": { "structural": "accept", "semantic": "reject", "code": "SEMANTIC_UNKNOWN_CANONICAL_REF" }
    },
    {
      "case_id": "dangling-proposed-reference",
